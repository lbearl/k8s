[Unit]
Description=Re-apply k3s nftables rules after Mullvad reconnect

[Service]
Type=oneshot
# Wait for Mullvad to finish recreating its nftables table
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do nft list table inet mullvad &>/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/sbin/nft -f /etc/mullvad-k3s-exclude.rules
# Pod CIDR (10.42.0.0/16)
ExecStart=/usr/sbin/nft insert rule inet mullvad forward ip daddr 10.42.0.0/16 accept
ExecStart=/usr/sbin/nft insert rule inet mullvad forward ip saddr 10.42.0.0/16 accept
ExecStart=/usr/sbin/nft insert rule inet mullvad input ip saddr 10.42.0.0/16 accept
ExecStart=/usr/sbin/nft insert rule inet mullvad output ip daddr 10.42.0.0/16 accept
# Service CIDR (10.43.0.0/16)
ExecStart=/usr/sbin/nft insert rule inet mullvad forward ip daddr 10.43.0.0/16 accept
ExecStart=/usr/sbin/nft insert rule inet mullvad forward ip saddr 10.43.0.0/16 accept
ExecStart=/usr/sbin/nft insert rule inet mullvad input ip saddr 10.43.0.0/16 accept
ExecStart=/usr/sbin/nft insert rule inet mullvad output ip daddr 10.43.0.0/16 accept
