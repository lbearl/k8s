# Exclude k3s pod and service network traffic from Mullvad VPN tunnel.
# Load with: sudo nft -f /etc/mullvad-k3s-exclude.rules
# Remove with: sudo nft delete table inet excludeK3s

define K3S_NETWORKS = {
    10.42.0.0/16,
    10.43.0.0/16
}

table inet excludeK3s {
    chain excludeOutgoing {
        type route hook output priority 0; policy accept;
        ip daddr $K3S_NETWORKS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
    }

    chain allowIncoming {
        type filter hook input priority -100; policy accept;
        ip saddr $K3S_NETWORKS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
    }

    chain allowForward {
        type filter hook forward priority -100; policy accept;
        ip saddr $K3S_NETWORKS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
        ip daddr $K3S_NETWORKS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
    }
}
